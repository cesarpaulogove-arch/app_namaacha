# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Ignorar configurações do editor (VS Code e Android Studio)
.idea/
.vscode/
*.iml

# Ignorar builds e arquivos temporários do Android
android/build/
android/app/build/
.gradle/
local.properties

# Ignorar arquivos gerados pelo sistema operacional
.DS_Store
Thumbs.db
# Ignorar arquivos de build locais do Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/captures/
android/*.iml
android/.idea/

# Se quiser ignorar as ferramentas de build do Gradle no PC
android/gradlew
android/gradlew.bat
android/gradle/
android/

